# Frontend environment variables
# Leave VITE_API_URL empty in local dev when using the Vite /api proxy,
# or point it at a deployed backend such as https://your-backend.onrender.com.
VITE_API_URL=

# Optional: override the local dev proxy target used by vite.config.js.
VITE_DEV_API_PROXY_TARGET=http://localhost:3002

# Optional: encrypt guest-mode localStorage data.
VITE_ENCRYPTION_KEY=

# Supabase cloud sync and email/password auth.
# Agropeuner project URL. Add the publishable key from Supabase after the
# project is active. VITE_SUPABASE_ANON_KEY is supported only as a legacy fallback.
VITE_SUPABASE_URL=https://aweyluvuvydbwdanodqe.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_AUTH_EMAIL_REDIRECT_URL=https://plant-2-uvev.onrender.com/login
# VITE_SUPABASE_ANON_KEY=

# Optional backend aliases for server-side curated disease-product rules.
SUPABASE_URL=https://aweyluvuvydbwdanodqe.supabase.co
SUPABASE_PUBLISHABLE_KEY=

# Backend CORS. Use a comma-separated list when the app is served from more
# than one domain, for example Render plus the production website.
FRONTEND_URL=https://plant-2-uvev.onrender.com
FRONTEND_URLS=https://ai.kanb.coop.my,https://www.mojosense.app,https://mojosense.app

# Server-only guest order signing secret (at least 32 characters).
ORDER_ACCESS_SECRET=
# Production diagnosis audit records use Supabase and the server-only service role.
DIAGNOSIS_DATA_BACKEND=supabase
DIAGNOSIS_RETENTION_DAYS=90
SUPABASE_SERVICE_ROLE_KEY=
# Per-IP guest allowance, total instance allowance, and concurrency cap.
AI_GUEST_DAILY_LIMIT=50
AI_SERVER_DAILY_LIMIT=1000
AI_MAX_CONCURRENT_REQUESTS=4
# Set only to the known number of trusted reverse proxy hops (Render: 1).
TRUST_PROXY_HOPS=0
