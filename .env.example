# Frontend environment variables
# Leave VITE_API_URL empty in local dev when using the Vite /api proxy,
# or point it at a deployed backend such as https://your-backend.onrender.com.
VITE_API_URL=

# Optional: override the local dev proxy target used by vite.config.js.
VITE_DEV_API_PROXY_TARGET=http://localhost:3002

# Optional: encrypt guest-mode localStorage data.
VITE_ENCRYPTION_KEY=
